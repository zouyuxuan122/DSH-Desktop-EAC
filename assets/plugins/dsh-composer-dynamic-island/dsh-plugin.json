{
  "$schema": "https://raw.githubusercontent.com/Yan-Zero/dsh-std/614dfa1ac168db79fcf4577cf0ebb34e2e3b944b/packages/manifest/schema/dsh-plugin-0.15.schema.json",
  "manifestVersion": "0.15",
  "id": "io.github.says693.composer-dynamic-island",
  "name": "DSH Composer Dynamic Island",
  "version": "2.1.0",
  "facets": {
    "host": {
      "entry": "lib/types/index.js",
      "apiVersion": "v1alpha1"
    }
  },
  "requires": {
    "contracts": []
  },
  "permissions": [],
  "contributes": {
    "commands": []
  },
  "subscriptions": [],
  "license": "MIT",
  "source": {
    "repository": "https://github.com/says693/dsh-composer-dynamic-island"
  },
  "overrides": [
    {
      "target": "dsh-web-profile",
      "kind": "patch",
      "description": "Optionally adds the DSH Web Cordis adapter row from cordis.patch.yml."
    }
  ],
  "x-dsh-web-adapter": {
    "entry": "lib/client.js",
    "loader": "dsh.client.web",
    "status": "optional-compatibility-layer",
    "standardFacet": false
  }
}
