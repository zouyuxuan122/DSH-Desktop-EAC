{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Deepseek Harness EAC",
  "version": "5.1.0",
  "identifier": "com.deepseek.dsh.desktop.tauri",
  "build": {},
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.ico"
    ],
    "resources": {
      "staged-resources/sidecar/": "sidecar/",
      "staged-resources/dsh-desktop/": "dsh-desktop/"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "SimpChinese",
          "English"
        ],
        "displayLanguageSelector": false,
        "installerHooks": "installer-hooks.nsh"
      }
    }
  }
}
