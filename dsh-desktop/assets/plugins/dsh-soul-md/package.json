{
    "name":  "dsh-soul-md",
    "version":  "0.2.8",
    "description":  "DeepSeek Harness 的 soul.md 风格人设卡插件：把 markdown 人设文件注入系统提示词（soul:persona），文件变更热重载，让 Agent 边干活边角色扮演；附 Web UI 设置栏。",
    "type":  "module",
    "main":  "index.js",
    "exports":  {
                    ".":  "./index.js",
                    "./client":  "./client.js",
                    "./package.json":  "./package.json"
                },
    "dsh":  {
                "client":  {
                               "platform":  "web"
                           }
            },
    "files":  [
                  "index.js",
                  "client.js",
                  "README.md",
                  "README.zh.md",
                  "LICENSE",
                  "examples",
                  "vendor"
              ],
    "homepage":  "https://github.com/Scorp1o117/dsh-soul-md",
    "keywords":  [
                     "dsh",
                     "dsh-plugin",
                     "deepseek-harness",
                     "persona",
                     "soul",
                     "roleplay",
                     "system-prompt"
                 ],
    "license":  "MIT",
    "engines":  {
                    "node":  "\u003e=20.18"
                },
    "repository":  {
                       "type":  "git",
                       "url":  "git+https://github.com/Scorp1o117/dsh-soul-md.git"
                   },
    "bugs":  {
                 "url":  "https://github.com/Scorp1o117/dsh-soul-md/issues"
             },
    "dependencies":  {
                         "@deepseek-ai/schemastery":  "^3.18.1"
                     },
    "peerDependencies":  {
                             "react":  "^18.2.0",
                             "@deepseek-ai/dsh-home-paths":  "^0.1.0-rc.6",
                             "@deepseek-ai/dsh-settings":  "^0.1.0-rc.6"
                         }
}