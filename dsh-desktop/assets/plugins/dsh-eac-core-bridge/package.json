{
  "name": "dsh-eac-core-bridge",
  "version": "1.0.0",
  "description": "VNext Phase 2 Core Bridge（受信组件）：把隔离 SDK 插件的工具/上下文贡献桥接进 dsh Agent。工具经回环端点转发到桌面 Supervisor 的 Extension Host；上下文注入带超时丢弃，扩展故障绝不阻塞核心回合。",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "platform": "none"
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "eac",
    "core-bridge",
    "extension-sdk"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22.18"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.6"
  }
}
