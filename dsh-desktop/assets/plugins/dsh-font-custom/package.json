{
  "name": "dsh-font-custom",
  "description": "外观自定义（DSH Desktop 配套插件）：设置页直接调整界面字体家族、字号与文字/代码颜色，实时预览、按主题变量覆盖、localStorage 持久化",
  "version": "0.1.0",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "license": "MIT"
}
