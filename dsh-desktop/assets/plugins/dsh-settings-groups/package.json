{
  "name": "dsh-settings-groups",
  "description": "设置页「常规」页内高级选项折叠（DSH Desktop 配套插件）：把低频使用的选项行（外观/语言/权限预设等，按行标题关键词识别）收进页面底部可折叠的「高级选项」组，默认收起，localStorage 持久化展开状态。纯客户端实现。",
  "version": "0.1.0",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  },
  "license": "MIT"
}