{
  "name": "dsh-web-mobile-fix",
  "version": "1.0.1",
  "description": "Mobile layout fixes for the DeepSeek Harness Web UI: settings panel, popups, sidebar, and session header on narrow (≤700px) screens. Pure client-side CSS overlay.",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AcidGr/dsh-web-mobile-fix.git"
  },
  "homepage": "https://github.com/AcidGr/dsh-web-mobile-fix",
  "bugs": {
    "url": "https://github.com/AcidGr/dsh-web-mobile-fix/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "mobile",
    "web-ui",
    "css"
  ]
}