    "ci:install": "node scripts/npm-ci-with-kernel.mjs",
    "install:plugin-engines": "node scripts/install-plugin-engines.mjs",
    "ledger:check": "node scripts/plugin-ledger.mjs",
    "plugin:kernel-compat": "node scripts/plugin-kernel-compat.mjs",
    "fetch-node": "npm run build && node scripts/fetch-node.js",
    "postinstall": "npm run build && node scripts/patch-deps.js || exit 0",
    "fetch-npm": "npm run build && node scripts/fetch-npm.js",
    "fetch-runtime": "npm run build && node scripts/fetch-node.js && node scripts/fetch-npm.js",
    "fetch-kernel": "npm run build && node scripts/fetch-kernel.js",
    "gen-kernel-overrides": "npm run build && node scripts/gen-kernel-overrides.js",
    "plugin:validate": "node scripts/plugin-sync.mjs validate --locked",
    "plugin:generate-registry": "node scripts/generate-plugin-registry.mjs",
    "plugin:sync": "node scripts/plugin-sync.mjs sync",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "tsc -p tsconfig.json",
    "build:native": "node scripts/build-native.js build",
    "test:native": "node scripts/build-native.js test",
    "clippy:native": "node scripts/build-native.js clippy",
    "pretest": "npm run build",
    "test": "node scripts/test-runner.js test/*.test.ts --test-timeout=120000 --test-force-exit"
  },
