{
  "name": "dsh-desktop",
  "productName": "Deepseek Harness EAC",
  "version": "5.2.0",
  "description": "DeepSeek Harness (dsh) 开箱即用的 Windows 桌面客户端：内置 dsh CLI 与 Node 运行时，一键启动 Web UI",
  "author": "DSH Desktop",
  "license": "MIT",
  "private": true,
  "scripts": {
    "fetch-node": "npm run build && node scripts/fetch-node.js",
    "postinstall": "npm run build && node scripts/patch-deps.js || exit 0",
    "fetch-npm": "npm run build && node scripts/fetch-npm.js",
    "fetch-runtime": "npm run build && node scripts/fetch-node.js && node scripts/fetch-npm.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "tsc -p tsconfig.json",
    "build:native": "node scripts/build-native.js build",
    "test:native": "node scripts/build-native.js test",
    "clippy:native": "node scripts/build-native.js clippy",
    "pretest": "npm run build",
    "test": "node scripts/test-runner.js test/*.test.ts --test-timeout=120000 --test-force-exit"
  },
  "dependencies": {
    "@deepseek-ai/cordis-plugin-group": "1.0.1",
    "@deepseek-ai/dsh": "0.1.1-rc.2",
    "@deepseek-ai/dsh-anonymous-user-id": "0.1.1-rc.2",
    "@deepseek-ai/dsh-atomic-write": "0.1.1-rc.2",
    "@deepseek-ai/dsh-authorization": "0.1.1-rc.2",
    "@deepseek-ai/dsh-bash-local": "0.1.1-rc.2",
    "@deepseek-ai/dsh-code-runtime": "0.1.1-rc.2",
    "@deepseek-ai/dsh-compaction": "0.1.1-rc.2",
    "@deepseek-ai/dsh-fs": "0.1.1-rc.2",
    "@deepseek-ai/dsh-invariants": "0.1.1-rc.2",
    "@deepseek-ai/dsh-output-retention": "0.1.1-rc.2",
    "@deepseek-ai/dsh-sandbox": "0.1.1-rc.2",
    "@deepseek-ai/dsh-scope": "0.1.1-rc.2",
    "@deepseek-ai/dsh-session-telemetry": "0.1.1-rc.2",
    "@deepseek-ai/dsh-session-title-llm": "0.1.1-rc.2",
    "@deepseek-ai/dsh-shell": "0.1.1-rc.2",
    "@deepseek-ai/dsh-spill": "0.1.1-rc.2",
    "@deepseek-ai/dsh-subagent-in-process-driver": "0.1.1-rc.2",
    "@deepseek-ai/dsh-subprocess": "0.1.1-rc.2",
    "@deepseek-ai/dsh-timeout": "0.1.1-rc.2",
    "@deepseek-ai/dsh-workflow": "0.1.1-rc.2",
    "archiver": "^7.0.1",
    "koffi": "3.1.5",
    "nanoid": "^3.3.18",
    "pino": "~8.21.0",
    "schemastery": "^3.18.0",
    "unzipper": "^0.12.3",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "typescript": "^7.0.2"
  }
}
