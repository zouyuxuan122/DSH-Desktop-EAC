{
  "name": "dsh-desktop-aio",
  "productName": "DSHEAC AIO",
  "version": "9.6.3",
  "description": "DSHEAC EAC 9.6.3（All-in-One）：整合 dsh CLI、Node 运行时、插件与技能快照的 Windows x64 发行版。",
  "main": "main.js",
  "author": "DSH Desktop",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "npm --prefix tauri-app run dev",
    "fetch-node": "node scripts/fetch-node.js",
    "predist": "node scripts/check-syntax.js",
    "prepack": "node scripts/check-syntax.js",
    "pack": "npm --prefix tauri-app run bundle",
    "dist": "powershell -NoProfile -File scripts/build-aio-release.ps1",
    "legacy:electron:start": "electron .",
    "legacy:electron:pack": "node scripts/patch-deps.js && electron-builder --dir",
    "legacy:electron:dist": "node scripts/patch-deps.js && electron-builder --win && node scripts/make-release-hashes.js",
    "postinstall": "node scripts/patch-deps.js || exit 0",
    "fetch-npm": "node scripts/fetch-npm.js",
    "fetch-runtime": "node scripts/fetch-node.js && node scripts/fetch-npm.js",
    "build:icon": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-icon.ps1",
    "build:native": "node scripts/build-native-runtime.mjs",
    "seed:sanitize": "node scripts/sanitize-public-seed.mjs",
    "electron:fetch": "node node_modules/electron/install.js",
    "pretest": "npm --prefix tauri-app run sidecar:build",
    "test": "node --test \"test/*.test.mjs\""
  },
  "dependencies": {
    "@deepseek-ai/dsh": "0.1.5-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.5-rc.2",
    "@deepseek-ai/dsh-client-store": "0.1.5-rc.2",
    "@deepseek-ai/dsh-client-ui-primitives": "0.1.5-rc.2",
    "@deepseek-ai/dsh-attachment": "0.1.5-rc.2",
    "@deepseek-ai/dsh-jobs": "0.1.5-rc.2",
    "@deepseek-ai/dsh-util-time": "0.1.5-rc.2",
    "@deepseek-ai/dsh-hook-protocol": "0.1.5-rc.2",
    "@deepseek-ai/dsh-sdk-protocol": "0.1.5-rc.2",
    "@deepseek-ai/dsh-session-persistence": "0.1.5-rc.2",
    "@deepseek-ai/dsh-session-query": "0.1.5-rc.2",
    "@deepseek-ai/dsh-settings": "0.1.5-rc.2",
    "@deepseek-ai/dsh-util-workspace-path": "0.1.5-rc.2",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "zustand": "4.4.7",
    "immer": "10.1.1",
    "@deepseek-ai/dsh-anonymous-user-id": "0.1.5-rc.2",
    "@deepseek-ai/dsh-atomic-write": "0.1.5-rc.2",
    "@deepseek-ai/dsh-authorization": "0.1.5-rc.2",
    "@deepseek-ai/dsh-bash-local": "0.1.5-rc.2",
    "@deepseek-ai/dsh-code-runtime": "0.1.5-rc.2",
    "@deepseek-ai/dsh-compaction": "0.1.5-rc.2",
    "@deepseek-ai/dsh-fs": "0.1.5-rc.2",
    "@deepseek-ai/dsh-invariants": "0.1.5-rc.2",
    "@deepseek-ai/dsh-output-retention": "0.1.5-rc.2",
    "@deepseek-ai/dsh-sandbox": "0.1.5-rc.2",
    "@deepseek-ai/dsh-scope": "0.1.5-rc.2",
    "@deepseek-ai/dsh-session-telemetry": "0.1.5-rc.2",
    "@deepseek-ai/dsh-session-title-llm": "0.1.5-rc.2",
    "@deepseek-ai/dsh-shell": "0.1.5-rc.2",
    "@deepseek-ai/dsh-spill": "0.1.5-rc.2",
    "@deepseek-ai/dsh-subagent-in-process-driver": "0.1.5-rc.2",
    "@deepseek-ai/dsh-timeout": "0.1.5-rc.2",
    "@deepseek-ai/dsh-workflow": "0.1.5-rc.2",
    "zstddec": "0.2.0",
    "@deepseek-ai/cordis-plugin-group": "1.0.2",
    "schemastery": "^3.18.0",
    "koffi": "3.1.5"
  },
  "devDependencies": {
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "fs-ext": "2.1.1"
  },
  "overrides": {
    "@xmldom/xmldom": "0.8.15",
    "fast-uri": "3.1.6",
    "js-yaml": "4.3.2",
    "qs": "6.16.0"
  }
}
