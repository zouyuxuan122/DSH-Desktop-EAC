node_modules/
dist/
vendor/
*.log
data/
.playwright-mcp/
.DS_Store
# Tauri 轨：cargo 构建目录与 staging 生成树（stage.ts 可完整重建）不入库
tauri-app/target/
tauri-app/resources/
# 本地代理工具状态
.zcode/
# 临时调试 / 备份产物不入库
debug-session-dump.cjs
e2e-base.txt
package.json.bak-*
scripts/tmp-dbg*.cjs
scripts/tmp-instrument.cjs
# build/ 只保留图标与 NSIS 安装脚本，其余构建产物不入库
build/*
!build/icon.ico
!build/icon.png
!build/installer.nsh
!build/ide-installer.nsh
# IDE / 便携版组装产物（数百 MB，经 GitHub Release 分发，不入库）
dist-ide/
dist-portable/
# 扩展本地编辑器配置
vscode/.vscode/
# 内置社区插件的 vendor / 自包含运行时依赖 / 离线数据必须随仓库分发，
# 否则克隆后构建出的安装包会复现“插件命名空间不可用”（vendor 缺失）
# 与“tdai-memory 无法启动”（sqlite-vec / jieba / BM25 语料缺失）
!assets/plugins/*/vendor/
!assets/plugins/*/data/
!assets/plugins/dsh-tdai-memory/node_modules/
!assets/plugins/dsh-tdai-memory/node_modules/**/data/
# 内置插件自带的嵌套 node_modules（vendored 运行时依赖）必须入库：
#   · dsh-market 的 undici（内核闭包不含，缺失则全新装机插件树加载失败）
#   · dsh-vision-router 的 undici/potrace/puppeteer-core 全家桶（自包含）
!assets/plugins/dsh-market/node_modules/
!assets/plugins/dsh-market/node_modules/**
!assets/plugins/dsh-vision-router/node_modules/
!assets/plugins/dsh-vision-router/node_modules/**
