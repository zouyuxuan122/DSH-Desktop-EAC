{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DSHEAC AIO",
  "mainBinaryName": "DSHEAC AIO",
  "version": "9.6.3",
  "identifier": "com.deepseek.dsh.desktop.aio",
  "build": {
    "beforeDevCommand": "npm run build:inject",
    "devUrl": null,
    "frontendDist": "./frontend",
    "beforeBuildCommand": "npm run prepare:bundle"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null,
      "capabilities": ["main"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico", "icons/icon.png"],
    "resources": ["resources/**/*"],
    "windows": {
      "webviewInstallMode": {
        "type": "offlineInstaller"
      },
      "nsis": {
        "installerHooks": "./nsis/installer-hooks.nsh",
        "languages": ["SimpChinese", "English"],
        "displayLanguageSelector": false
      }
    }
  }
}
