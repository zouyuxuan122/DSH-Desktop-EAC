{
  "name": "dsh-desktop-aio-tauri",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "scripts": {
    "build:inject": "node build-inject.mjs",
    "tauri": "tauri",
    "dev": "npm run build:inject && npm run sidecar:build && tauri dev",
    "build": "npm run build:inject && npm run sidecar:build && node scripts/stage.ts && tauri build",
    "bundle": "tauri build",
    "sidecar:build": "tsc -p ../sidecar/tsconfig.json",
    "sidecar:check": "tsc -p ../sidecar/tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.9.6",
    "@types/node": "^24.13.3",
    "esbuild": "^0.25.0",
    "typescript": "^5.6.0"
  }
}
